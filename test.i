    : p_(p)
  {
  }


  ~scoped_ptr()
  {
    delete p_;
  }


  T* get()
  {
    return p_;
  }


  T* operator->()
  {
    return p_;
  }


  T& operator*()
  {
    return *p_;
  }


  void reset(T* p = 0)
  {
    delete p_;
    p_ = p;
  }


  T* release()
  {
    T* tmp = p_;
    p_ = 0;
    return tmp;
