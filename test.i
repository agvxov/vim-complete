            run.push_back(range);
            return;
        }


        typename storage_type::iterator iter =
            std::upper_bound(
                run.begin(), run.end(), range,
                range_compare<range_type>()
            );

        if (iter != run.begin())
        {

            if (includes(*(iter-1), range))
            {
                return;
            }


            if (try_merge(run, iter-1, range))
            {
                return;
            }
        }


        if (iter == run.end() || !try_merge(run, iter, range))
        {

            run.insert(iter, range);
        }
    }

