  {
    if (!blocked_)
    {
      sigset_t new_mask;
      sigfillset(&new_mask);
      blocked_ = (pthread_sigmask(0, &new_mask, &old_mask_) == 0);
    }
  }


  void unblock()
  {
    if (blocked_)
      blocked_ = (pthread_sigmask(2, &old_mask_, 0) != 0);
  }

private:

  bool blocked_;


